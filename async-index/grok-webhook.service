# grok-webhook.service — systemd unit for the Drive Changes API webhook receiver.
#
# INSTALL (run on the laptop as the laptop user, with sudo for the copy/enable):
#   1. Copy the code into place:
#        sudo mkdir -p /opt/grok
#        sudo cp webhook_receiver.py /opt/grok/webhook_receiver.py
#   2. Create the token config (NOT in the repo; owned by the laptop user):
#        mkdir -p ~/.grok
#        printf 'WEBHOOK_TOKEN=%s\n' "$(openssl rand -hex 24)" > ~/.grok/webhook.conf
#        chmod 600 ~/.grok/webhook.conf
#   3. Edit the User= line below to the laptop username, then install the unit:
#        sudo cp grok-webhook.service /etc/systemd/system/grok-webhook.service
#        sudo systemctl daemon-reload
#        sudo systemctl enable --now grok-webhook
#        systemctl status grok-webhook
#
# NOTE: binding port 80 requires either running as root or granting the python
# binary CAP_NET_BIND_SERVICE. If you prefer not to run as root, the receiver
# auto-falls back to port 8080 (see webhook_receiver.py). Easiest: either run
# as root (User=root) OR change to port 8080 and reverse-proxy 443->8080 via
# your TLS/verified-HTTPS front end (see README-grok-agent.md).

[Unit]
Description=Grok Drive Changes API webhook receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Change this to the laptop user who owns ~/.grok/webhook.conf:
User=user
ExecStart=/usr/bin/python3 /opt/grok/webhook_receiver.py
Restart=always
RestartSec=5
# Allow binding low ports without full root (optional; keep if User is non-root):
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
