[Desktop Entry]
Name=Grok Bot
GenericName=Grok desktop agent
Comment=AI teammate desktop client
Exec=@BIN@ %U
Icon=@ICON@
Type=Application
Categories=Network;Office;Development;
StartupWMClass=grok-bot
MimeType=x-scheme-handler/grokbot;
Terminal=false
StartupNotify=true
Keywords=Grok;xAI;AI;Agent;
Actions=update;

[Desktop Action update]
Name=Update Grok Bot
Exec=@BIN@ update --notify
